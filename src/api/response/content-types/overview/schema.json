{
  "kind": "collectionType",
  "collectionName": "overviews",
  "info": {
    "singularName": "overview",
    "pluralName": "overviews",
    "displayName": "Response.Overview"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "subHeading": {
      "type": "text"
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "imageGallery": {
      "type": "component",
      "component": "response.image-reference",
      "repeatable": true,
      "max": 2
    },
    "processImageMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "processImageDesktop": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "callToActionCards": {
      "type": "component",
      "component": "response.call-to-action",
      "repeatable": true,
      "required": true
    },
    "faqs": {
      "type": "component",
      "component": "response.faq-item",
      "repeatable": true
    },
    "slug": {
      "type": "string",
      "unique": true
    },
    "impactStatistics": {
      "type": "component",
      "component": "response.impact-statistics-section",
      "repeatable": false
    },
    "aboutHeading": {
      "type": "string"
    },
    "details": {
      "type": "component",
      "component": "response.detail",
      "repeatable": true
    },
    "processHeading": {
      "type": "string",
      "default": "How We Work"
    },
    "processFootnote": {
      "type": "text"
    },
    "fundraisers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::response.fundraiser"
    }
  }
}
